[gd_resource type="Theme" load_steps=3 format=3]

; Tema de proyecto (gui/theme/custom). Solo pone una cosa: la fuente por defecto es la de Godot
; —un FontVariation sin base_font cae en ThemeDB.fallback_font— con Noto Color Emoji de reserva.
; En escritorio los emoji salían de las fuentes del sistema; en web no hay, y salían cajas con su
; código (Plan «Builds Públicas», M0b). Va en el tema de proyecto, que se aplica antes de crear
; ningún Control: cambiar el tema de uno ya montado cuesta ~6 ms (ver CLAUDE.md).
; tools/font_test.gd comprueba que esta fuente tiene todos los emoji que usa el código.

[ext_resource type="FontFile" path="res://assets/fonts/NotoColorEmoji.ttf" id="1_emoji"]

[sub_resource type="FontVariation" id="FontVariation_base"]
fallbacks = Array[Font]([ExtResource("1_emoji")])

[resource]
default_font = SubResource("FontVariation_base")
